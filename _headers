# LSE6 canonical headers
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://tracker.metricool.com; media-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://tracker.metricool.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://tracker.metricool.com https://*.metricool.com;
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cache-Control: public, max-age=0, must-revalidate

/lse6-assets/public-media/*
  Cache-Control: public, max-age=31536000, immutable

/lse6-assets/lse6-miniaturas/*
  Cache-Control: public, max-age=31536000, immutable

/lse6-assets/LSE6_LOGO_TRANSPARENTE.png
  Cache-Control: public, max-age=31536000, immutable

/lse6-assets/LSE6_GREENTECH_TRANSPARENTE.png
  Cache-Control: public, max-age=31536000, immutable

/lse6-assets/BarrioBravoRecords.png
  Cache-Control: public, max-age=31536000, immutable

/lse6-assets/lse6-og.png
  Cache-Control: public, max-age=31536000, immutable

/lse6-assets/lse6-symbol.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400
*.ico
  Cache-Control: max-age=31536000, public
*.mp4
  Cache-Control: max-age=31536000, public
*.webmanifest
  Cache-Control: max-age=3600, public, must-revalidate

# Superficies públicas de máquina: descubribles, enlazables e indexables para agentes que respeten X-Robots-Tag.
/site.webmanifest
  X-Robots-Tag: index, follow

# Las miniaturas oficiales pueden cambiar en YouTube
/lse6-assets/youtube-thumbnails/*
  Cache-Control: public, max-age=3600, must-revalidate

/*.json
  X-Robots-Tag: index, follow

/lse6-*/index.json
  X-Robots-Tag: index, follow

/mandela/index.json
  X-Robots-Tag: index, follow

# Código operativo/herramientas e instrucciones de mantenimiento NO forman parte del corpus público indexable.
/tools/*
  X-Robots-Tag: noindex, nofollow

/lse6-assets/public-media/*.txt
  X-Robots-Tag: noindex, nofollow

/lse6-mayo-2025/lse6-pdf/LSE6_MAYO_2025_EXTRA.txt
  X-Robots-Tag: noindex, nofollow

/404.html
  X-Robots-Tag: noindex, follow
  Cache-Control: no-store

# Los hosts de Cloudflare Pages no compiten con el dominio canónico.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# MANDELA: landing y documento maestro indexables.
/mandela/
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large

/mandela/LSE6_EXPEDIENTE_MANDELA_LEY_TEMPORAL_V2_BLINDADO.pdf
  X-Robots-Tag: index, follow, max-snippet:-1
  Cache-Control: public, max-age=86400, must-revalidate

/mandela/LSE6_EXPEDIENTE_MANDELA_LEY_TEMPORAL_V2_BLINDADO.txt
  X-Robots-Tag: index, follow, max-snippet:-1
  Cache-Control: public, max-age=3600, must-revalidate
